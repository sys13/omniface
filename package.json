{
  "name": "facet-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "test": "pnpm build && vitest run",
    "test:only": "vitest run",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test:only",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/publish.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "demo": "node demo/run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.9.0"
}
