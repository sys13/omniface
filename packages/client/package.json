{
  "name": "@omniface/client",
  "version": "0.1.0",
  "description": "Runtime shared by omniface's TypeScript SDK and CLI: auth, retries, idempotency keys, pagination, typed errors.",
  "keywords": [
    "omniface",
    "sdk",
    "client",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sys13/omniface.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/sys13/omniface#readme",
  "bugs": "https://github.com/sys13/omniface/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "omniface": "workspace:^"
  },
  "devDependencies": {
    "omniface": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependenciesMeta": {
    "omniface": {
      "optional": true
    }
  }
}
